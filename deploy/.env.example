# Copy to .env (git-ignored).
REDIS_PORT=6380            # host port of the bundled Redis
GATEWAY_BIND=127.0.0.1     # 0.0.0.0 to reach it from a headset on the LAN, or behind CloudFront
GATEWAY_PORT=8090
# REDIS_URL=redis://hub:6379   # use an existing Redis instead of the bundled one
XRTEL_NAMESPACE=
BASE_PATH=                 # /telemetry behind CloudFront
# Empty = open (trusted LAN). On the Internet set both: openssl rand -hex 24
INGEST_TOKEN=
CONSUME_TOKEN=
