# Copy to .env (git-ignored).
# Comments on their own lines: after an empty value, Compose reads them as the value.

# Host port of the bundled Redis (6379 is often taken already).
REDIS_PORT=6380

# 0.0.0.0 to reach the gateway from a headset on the LAN, or behind CloudFront.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=8090

# Use an existing Redis instead of the bundled one:
# REDIS_URL=redis://hub:6379

XRTEL_NAMESPACE=

# /telemetry behind CloudFront.
BASE_PATH=

# The gateway serves fixed paths under BASE_PATH; these settings only decide
# the host, port and prefix. With the values above:
#   ingest   ws://<host>:${GATEWAY_PORT}${BASE_PATH}/ingest?token=<INGEST_TOKEN>    producers
#   consume  ws://<host>:${GATEWAY_PORT}${BASE_PATH}/consume?token=<CONSUME_TOKEN>  live readers
#   console  http://<host>:${GATEWAY_PORT}${BASE_PATH}/ui/
#   health   http://<host>:${GATEWAY_PORT}${BASE_PATH}/health
# wss:// and https:// with TLS_KEY/TLS_CERT below, or behind CloudFront.

# Lab LAN TLS: the gateway's own certificate. Put key.pem and cert.pem in
# deploy/certs/ and uncomment the certs volume in docker-compose.yml.
# TLS_KEY=/certs/key.pem
# TLS_CERT=/certs/cert.pem

# Empty = open (trusted LAN). On the Internet set both: openssl rand -hex 24
INGEST_TOKEN=
CONSUME_TOKEN=

# Archive retention. A session is deleted this many days after its last
# sample (0 = keep forever). One headset at 20 Hz is ~36 MB per hour.
ARCHIVE_RETENTION_DAYS=30
# Also delete the oldest finished sessions while the archive is bigger than
# this (0 = no limit). On an 8 GB EC2 disk, 4000 leaves room for the system.
ARCHIVE_MAX_MB=0
